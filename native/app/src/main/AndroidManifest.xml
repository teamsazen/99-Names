<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No ads: keep Firebase Analytics away from the advertising ID and the
         Privacy Sandbox ad APIs it would otherwise merge in. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="99 Names"
        android:supportsRtl="true"
        android:theme="@style/Theme.AsmaulHusna">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase Analytics collects only in release builds (analyticsEnabled
             in app/build.gradle.kts), never the advertising ID. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="${analyticsEnabled}" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
    </application>

    <!-- Lets the "Privacy" and "Terms" rows find a browser with Custom Tabs. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
